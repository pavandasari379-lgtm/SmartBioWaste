# SmartBioWaste AI Backend Environment Configuration

# Project
PROJECT_NAME="SmartBioWaste AI"
PROJECT_VERSION="1.0.0"

# JWT Secret Key
SECRET_KEY="smartbiowaste-ai-production-super-secret-key-2026"

# Database Connection (PostgreSQL)
# Format: postgresql://<username>:<password>@localhost:5432/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartbiowaste"

# Machine Learning Mode
# Set to 'false' to load real EfficientNet-B0 weights from MODEL_PATH
DEMO_MODE=true
MODEL_PATH="../../ml/models/efficientnet_b0_waste.pth"
